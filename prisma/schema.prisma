datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// --------------------------------------------------------
// ENUMS FOR INBOX, WORKFLOWS & PRESENCE
// --------------------------------------------------------

enum NotificationCategory {
  ALL
  TASKS
  DIRECT_MESSAGES
  GROUP_CHATS
  GMAIL
  MENTIONS
  COMMENTS
  REMINDERS
  APPROVALS
  SYSTEM
  CALENDAR
  FILES
}

enum NotificationPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum ConversationType {
  DIRECT
  DEPARTMENT
  COMPANY_ALL_HANDS
  PROJECT
}

enum ParticipantRole {
  ADMIN
  LEAD
  MEMBER
}

enum MessageType {
  TEXT
  TASK_CARD
  FILE
  VOICE
  IMAGE
  PROJECT_CARD
}

enum UserPresenceStatus {
  ONLINE
  AWAY
  BUSY
  OFFLINE
}

// --------------------------------------------------------
// CORE WORKSPACE & USER MODELS
// --------------------------------------------------------

model Organization {
  id                  String               @id @default(auto()) @map("_id") @db.ObjectId
  name                String
  slug                String               @unique
  timezone            String               @default("UTC")
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt

  users               User[]
  departments         Department[]
  teams               Team[]
  projects            Project[]
  tasks               Task[]
  goals               Goal[]
  notifications       Notification[]
  reminders           Reminder[]
  automations         Automation[]
  emailNotifications  EmailNotification[]
  taskTemplates       TaskTemplate[]
  webhookEvents       WebhookEvent[]
  auditLogs           AuditLog[]
  escalationRules     EscalationRule[]
  tags                Tag[]
  recurringTemplates  RecurringTemplate[]
  habits              Habit[]
  timeBlocks          TimeBlock[]
  conversations       Conversation[]
  activityLogs        ActivityLog[]
}

model Permission {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  name      String   @unique
  createdAt DateTime @default(now())
  roles     Role[]   @relation(fields: [roleIds], references: [id])
  roleIds   String[] @db.ObjectId
}

model Role {
  id            String       @id @default(auto()) @map("_id") @db.ObjectId
  name          String       @unique
  users         User[]
  permissions   Permission[] @relation(fields: [permissionIds], references: [id])
  permissionIds String[]     @db.ObjectId
  createdAt     DateTime     @default(now())
}

model User {
  id                   String               @id @default(auto()) @map("_id") @db.ObjectId
  name                 String
  email                String               @unique
  memberCode           String?              // Unique handle (e.g. Umang2390)
  passwordHash         String?              // Nullable for OAuth-exclusive authentication
  avatarUrl            String?
  timezone             String               @default("UTC")
  presenceStatus       UserPresenceStatus   @default(OFFLINE)
  lastSeenAt           DateTime?            @default(now())

  organizationId       String?              @db.ObjectId
  organization         Organization?        @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  roleId               String?              @db.ObjectId
  role                 Role?                @relation(fields: [roleId], references: [id], onDelete: SetNull)
  teamId               String?              @db.ObjectId
  team                 Team?                @relation(fields: [teamId], references: [id], onDelete: SetNull)
  departmentId         String?              @db.ObjectId
  department           Department?          @relation(fields: [departmentId], references: [id], onDelete: SetNull)

  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt

  // Task & Project Relations
  tasksCreated         Task[]               @relation("TaskCreator")
  taskAssignments      TaskAssignee[]
  comments             Comment[]
  notifications        Notification[]
  activityLogs         ActivityLog[]
  projectMembership    ProjectMember[]
  goals                Goal[]
  timeEntries          TimeEntry[]
  reminders            Reminder[]
  approvals            Approval[]
  calendarIntegrations CalendarIntegration[]
  oauthAccounts        OAuthAccount[]
  sessions             Session[]
  pushSubscriptions    PushSubscription[]
  emailNotifications   EmailNotification[]
  commentMentions      CommentMention[]     @relation("MentionedUser")
  attachments          Attachment[]
  recurringTemplates   RecurringTemplate[]  @relation("RecurringTemplateCreator")
  habits               Habit[]
  habitLogs            HabitLog[]
  timeBlocks           TimeBlock[]
  gmailAccounts        GmailAccount[]

  // Real-time Chat Relations
  messagesSent            Message[]                 @relation("MessageSender")
  conversationMemberships ConversationParticipant[]
  createdConversations    Conversation[]            @relation("ConversationCreator")

  @@index([organizationId, presenceStatus])
  @@index([departmentId])
  @@index([memberCode])
}

model Department {
  id             String         @id @default(auto()) @map("_id") @db.ObjectId
  name           String
  description    String?
  organizationId String         @db.ObjectId
  organization   Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  users          User[]
  teams          Team[]
  tasks          Task[]
  conversations  Conversation[]
  createdAt      DateTime       @default(now())

  @@unique([organizationId, name])
  @@index([organizationId])
}

model Team {
  id             String        @id @default(auto()) @map("_id") @db.ObjectId
  name           String
  organizationId String        @db.ObjectId
  organization   Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  departmentId   String?       @db.ObjectId
  department     Department?   @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  members        User[]
  tasks          Task[]
  createdAt      DateTime      @default(now())

  @@index([organizationId])
}

model Project {
  id             String          @id @default(auto()) @map("_id") @db.ObjectId
  name           String
  description    String?
  deadline       DateTime?
  organizationId String          @db.ObjectId
  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  members        ProjectMember[]
  tasks          Task[]
  conversations  Conversation[]
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  @@index([organizationId])
}

model ProjectMember {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  userId    String   @db.ObjectId
  projectId String   @db.ObjectId
  role      String   @default("member")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([userId, projectId])
}

// --------------------------------------------------------
// TASK SYSTEM
// --------------------------------------------------------

model Task {
  id                  String               @id @default(auto()) @map("_id") @db.ObjectId
  title               String
  description         String?
  status              String               @default("DRAFT")
  priority            String               @default("P3")
  organizationId      String               @db.ObjectId
  organization        Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  projectId           String?              @db.ObjectId
  project             Project?             @relation(fields: [projectId], references: [id], onDelete: SetNull)
  departmentId        String?              @db.ObjectId
  department          Department?          @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  teamId              String?              @db.ObjectId
  team                Team?                @relation(fields: [teamId], references: [id], onDelete: SetNull)
  creatorId           String?              @db.ObjectId
  creator             User?                @relation("TaskCreator", fields: [creatorId], references: [id], onDelete: SetNull)
  assignees           TaskAssignee[]
  assigneeEmail       String?
  dueAt               DateTime?
  startAt             DateTime?
  estimatedMinutes    Int?
  actualMinutes       Int?
  recurrence          String?
  completionProofType String?
  approvalRequired    Boolean              @default(false)
  calendarSyncEnabled Boolean              @default(false)
  emailEnabled        Boolean              @default(true)
  completedAt         DateTime?
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt

  comments            Comment[]
  reminders           Reminder[]
  notifications       Notification[]
  approvals           Approval[]
  timeEntries         TimeEntry[]
  dependencies        TaskDependency[]     @relation("TaskDependencySource")
  dependentTasks      TaskDependency[]     @relation("TaskDependencyTarget")
  checklistItems      ChecklistItem[]
  subtasks            Subtask[]
  taskTags            TaskTag[]
  attachments         Attachment[]
  calendarEvent       CalendarEvent?
  activityLogs        ActivityLog[]
  emailNotifications  EmailNotification[]
  escalationRules     EscalationRule[]
  timeBlocks          TimeBlock[]
  recurringInstances  RecurringTemplate[]  @relation("RecurringTemplateTask")
  gmailThreads        GmailThread[]
  messages            Message[]

  @@index([organizationId, status])
  @@index([dueAt])
  @@index([projectId])
}

model TaskAssignee {
  id     String @id @default(auto()) @map("_id") @db.ObjectId
  taskId String @db.ObjectId
  userId String @db.ObjectId
  task   Task   @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([taskId, userId])
}

model TaskDependency {
  id          String @id @default(auto()) @map("_id") @db.ObjectId
  taskId      String @db.ObjectId
  dependsOnId String @db.ObjectId
  task        Task   @relation("TaskDependencySource", fields: [taskId], references: [id], onDelete: Cascade)
  dependsOn   Task   @relation("TaskDependencyTarget", fields: [dependsOnId], references: [id], onDelete: Cascade)

  @@unique([taskId, dependsOnId])
}

model Comment {
  id          String           @id @default(auto()) @map("_id") @db.ObjectId
  content     String
  taskId      String           @db.ObjectId
  task        Task             @relation(fields: [taskId], references: [id], onDelete: Cascade)
  authorId    String           @db.ObjectId
  author      User             @relation(fields: [authorId], references: [id], onDelete: Cascade)
  parentId    String?          @db.ObjectId
  parent      Comment?         @relation("CommentReplies", fields: [parentId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  replies     Comment[]        @relation("CommentReplies")
  mentions    CommentMention[]
  attachments Attachment[]
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
}

// --------------------------------------------------------
// INBOX & REAL-TIME COMMUNICATIONS
// --------------------------------------------------------

model Notification {
  id             String               @id @default(auto()) @map("_id") @db.ObjectId
  type           String               @default("GENERAL")
  category       NotificationCategory @default(ALL)
  priority       NotificationPriority @default(MEDIUM)
  content        String
  title          String?
  read           Boolean              @default(false)
  pinned         Boolean              @default(false)
  archived       Boolean              @default(false)
  snoozedUntil   DateTime?
  userId         String               @db.ObjectId
  user           User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  actorId        String?              @db.ObjectId
  taskId         String?              @db.ObjectId
  task           Task?                @relation(fields: [taskId], references: [id], onDelete: SetNull)
  organizationId String?              @db.ObjectId
  organization   Organization?        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  link           String?
  entityType     String?
  entityId       String?
  metadata       Json?
  createdAt      DateTime             @default(now())

  @@index([userId, read, archived])
  @@index([organizationId, category])
}

model Conversation {
  id             String                    @id @default(auto()) @map("_id") @db.ObjectId
  organizationId String                    @db.ObjectId
  organization   Organization              @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  type           ConversationType          @default(DEPARTMENT)
  name           String?
  image          String?
  description    String?

  departmentId   String?                   @db.ObjectId
  department     Department?               @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  projectId      String?                   @db.ObjectId
  project        Project?                  @relation(fields: [projectId], references: [id], onDelete: SetNull)

  creatorId      String?                   @db.ObjectId
  creator        User?                     @relation("ConversationCreator", fields: [creatorId], references: [id], onDelete: SetNull)

  lastMessageAt  DateTime                  @default(now())
  createdAt      DateTime                  @default(now())
  updatedAt      DateTime                  @updatedAt

  participants   ConversationParticipant[]
  messages       Message[]

  @@index([organizationId, type])
  @@index([organizationId, lastMessageAt])
}

model ConversationParticipant {
  id             String          @id @default(auto()) @map("_id") @db.ObjectId
  conversationId String          @db.ObjectId
  conversation   Conversation    @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  userId         String          @db.ObjectId
  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  role           ParticipantRole @default(MEMBER)
  joinedAt       DateTime        @default(now())
  lastReadAt     DateTime        @default(now())

  @@unique([conversationId, userId])
  @@index([userId])
}

model Message {
  id             String          @id @default(auto()) @map("_id") @db.ObjectId
  conversationId String          @db.ObjectId
  conversation   Conversation    @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderId       String          @db.ObjectId
  sender         User            @relation("MessageSender", fields: [senderId], references: [id], onDelete: Cascade)
  content        String
  type           MessageType     @default(TEXT)
  mediaUrl       String?
  mediaName      String?
  taskId         String?         @db.ObjectId
  task           Task?           @relation(fields: [taskId], references: [id], onDelete: SetNull)
  replyToId      String?         @db.ObjectId
  mentions       String[]        @default([])
  readByIds      String[]        @default([])
  reactions      Json?
  isPinned       Boolean         @default(false)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  @@index([conversationId, createdAt])
}

model GmailAccount {
  id           String        @id @default(auto()) @map("_id") @db.ObjectId
  userId       String        @db.ObjectId
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  email        String
  accessToken  String
  refreshToken String
  syncStatus   String        @default("IDLE")
  lastSyncedAt DateTime?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  threads      GmailThread[]

  @@unique([userId, email])
}

model GmailThread {
  id         String       @id @default(auto()) @map("_id") @db.ObjectId
  accountId  String       @db.ObjectId
  account    GmailAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  threadId   String
  subject    String
  snippet    String
  from       String
  to         String[]
  labels     String[]
  isStarred  Boolean      @default(false)
  isRead     Boolean      @default(false)
  receivedAt DateTime
  taskId     String?      @db.ObjectId
  task       Task?        @relation(fields: [taskId], references: [id], onDelete: SetNull)
  createdAt  DateTime     @default(now())

  @@index([accountId, receivedAt])
}

// --------------------------------------------------------
// ROUTINES, HABITS & TIME BLOCKING
// --------------------------------------------------------

model Habit {
  id             String       @id @default(auto()) @map("_id") @db.ObjectId
  organizationId String       @db.ObjectId
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId         String       @db.ObjectId
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  name           String
  frequencyDays  Int[]
  active         Boolean      @default(true)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  logs           HabitLog[]

  @@index([organizationId, userId, active])
}

model HabitLog {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  habitId   String   @db.ObjectId
  habit     Habit    @relation(fields: [habitId], references: [id], onDelete: Cascade)
  userId    String   @db.ObjectId
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  date      String
  completed Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([habitId, date])
  @@index([userId, date])
}

model TimeBlock {
  id             String       @id @default(auto()) @map("_id") @db.ObjectId
  organizationId String       @db.ObjectId
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId         String       @db.ObjectId
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  taskId         String?      @db.ObjectId
  task           Task?        @relation(fields: [taskId], references: [id], onDelete: SetNull)
  startTime      DateTime
  endTime        DateTime
  type           String
  title          String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([userId, startTime])
}

model RecurringTemplate {
  id                String               @id @default(auto()) @map("_id") @db.ObjectId
  organizationId    String               @db.ObjectId
  organization      Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  creatorId         String?              @db.ObjectId
  creator           User?                @relation("RecurringTemplateCreator", fields: [creatorId], references: [id], onDelete: SetNull)
  title             String
  description       String?
  frequency         String
  timeOfDay         String?
  subtaskTemplates  String[]
  active            Boolean              @default(true)
  lastGeneratedDate String?
  generatedTaskId   String?              @db.ObjectId
  generatedTask     Task?                @relation("RecurringTemplateTask", fields: [generatedTaskId], references: [id], onDelete: SetNull)
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt

  @@index([organizationId, active])
}

// --------------------------------------------------------
// SUPPORTING UTILITIES & AUDITING
// --------------------------------------------------------

model Reminder {
  id             String        @id @default(auto()) @map("_id") @db.ObjectId
  taskId         String        @db.ObjectId
  task           Task          @relation(fields: [taskId], references: [id], onDelete: Cascade)
  userId         String?       @db.ObjectId
  user           User?         @relation(fields: [userId], references: [id], onDelete: SetNull)
  organizationId String?       @db.ObjectId
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  sendAt         DateTime
  type           String
  sent           Boolean       @default(false)
  createdAt      DateTime      @default(now())

  @@index([sendAt, sent])
}

model EscalationRule {
  id               String        @id @default(auto()) @map("_id") @db.ObjectId
  organizationId   String        @db.ObjectId
  organization     Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  taskId           String?       @db.ObjectId
  task             Task?         @relation(fields: [taskId], references: [id], onDelete: SetNull)
  delayHours       Int
  recipientRole    String
  notificationType String
  repeatEveryHours Int?
  enabled          Boolean       @default(true)
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  @@index([organizationId, enabled])
}

model CalendarIntegration {
  id               String    @id @default(auto()) @map("_id") @db.ObjectId
  userId           String    @db.ObjectId
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider         String    @default("google")
  googleCalendarId String?
  accessToken      String?
  refreshToken     String?
  expiresAt        DateTime?
  status           String    @default("PENDING")
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@unique([userId, provider])
}

model CalendarEvent {
  id            String    @id @default(auto()) @map("_id") @db.ObjectId
  taskId        String    @unique @db.ObjectId
  task          Task      @relation(fields: [taskId], references: [id], onDelete: Cascade)
  googleEventId String?
  status        String    @default("PENDING")
  lastSyncedAt  DateTime?
  syncError     String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model Automation {
  id             String       @id @default(auto()) @map("_id") @db.ObjectId
  name           String
  whenTrigger    String
  condition      String
  action         String
  organizationId String       @db.ObjectId
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  enabled        Boolean      @default(true)
  createdAt      DateTime     @default(now())
}

model Goal {
  id             String       @id @default(auto()) @map("_id") @db.ObjectId
  title          String
  targetValue    Int
  currentValue   Int          @default(0)
  ownerId        String?      @db.ObjectId
  owner          User?        @relation(fields: [ownerId], references: [id], onDelete: SetNull)
  organizationId String       @db.ObjectId
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdAt      DateTime     @default(now())
}

model Approval {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  taskId     String   @db.ObjectId
  task       Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  reviewerId String   @db.ObjectId
  reviewer   User     @relation(fields: [reviewerId], references: [id], onDelete: Cascade)
  status     String   @default("PENDING")
  reason     String?
  createdAt  DateTime @default(now())
}

model TimeEntry {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  taskId    String   @db.ObjectId
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  userId    String   @db.ObjectId
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  minutes   Int
  note      String?
  createdAt DateTime @default(now())
}

model ActivityLog {
  id             String        @id @default(auto()) @map("_id") @db.ObjectId
  taskId         String?       @db.ObjectId
  task           Task?         @relation(fields: [taskId], references: [id], onDelete: SetNull)
  userId         String?       @db.ObjectId
  user           User?         @relation(fields: [userId], references: [id], onDelete: SetNull)
  organizationId String?       @db.ObjectId
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  action         String
  details        String?
  createdAt      DateTime      @default(now())

  @@index([taskId, createdAt])
  @@index([organizationId, createdAt])
}

model PushSubscription {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  userId    String   @db.ObjectId
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

model UserPreference {
  id            String   @id @default(auto()) @map("_id") @db.ObjectId
  userId        String   @unique @db.ObjectId
  theme         String   @default("light")
  timezone      String   @default("UTC")
  notifications Boolean  @default(true)
  emailDigest   Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model AuditLog {
  id             String        @id @default(auto()) @map("_id") @db.ObjectId
  actorId        String?       @db.ObjectId
  action         String
  target         String?
  details        String?
  organizationId String?       @db.ObjectId
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  createdAt      DateTime      @default(now())

  @@index([organizationId, createdAt])
}

model OAuthAccount {
  id                String    @id @default(auto()) @map("_id") @db.ObjectId
  provider          String
  providerAccountId String
  userId            String    @db.ObjectId
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken       String?
  refreshToken      String?
  expiresAt         DateTime?
  createdAt         DateTime  @default(now())

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  userId    String   @db.ObjectId
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

model Subtask {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  taskId      String   @db.ObjectId
  task        Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  title       String
  description String?
  completed   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([taskId])
}

model ChecklistItem {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  taskId    String   @db.ObjectId
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  text      String
  checked   Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([taskId])
}

model Tag {
  id             String       @id @default(auto()) @map("_id") @db.ObjectId
  name           String
  organizationId String       @db.ObjectId
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  taskTags       TaskTag[]
  createdAt      DateTime     @default(now())

  @@unique([organizationId, name])
}

model TaskTag {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  taskId    String   @db.ObjectId
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  tagId     String   @db.ObjectId
  tag       Tag      @relation(fields: [tagId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([taskId, tagId])
}

model CommentMention {
  id              String   @id @default(auto()) @map("_id") @db.ObjectId
  commentId       String   @db.ObjectId
  comment         Comment  @relation(fields: [commentId], references: [id], onDelete: Cascade)
  mentionedUserId String   @db.ObjectId
  mentionedUser   User     @relation("MentionedUser", fields: [mentionedUserId], references: [id], onDelete: Cascade)
  createdAt       DateTime @default(now())

  @@unique([commentId, mentionedUserId])
}

model Attachment {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  taskId    String?  @db.ObjectId
  task      Task?    @relation(fields: [taskId], references: [id], onDelete: SetNull)
  commentId String?  @db.ObjectId
  comment   Comment? @relation(fields: [commentId], references: [id], onDelete: SetNull)
  userId    String?  @db.ObjectId
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  name      String
  mimeType  String?
  url       String
  sizeBytes Int?
  createdAt DateTime @default(now())

  @@index([taskId])
  @@index([commentId])
}

model TaskTemplate {
  id                     String             @id @default(auto()) @map("_id") @db.ObjectId
  organizationId         String             @db.ObjectId
  organization           Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name                   String
  description            String?
  defaultPriority        String             @default("MEDIUM")
  defaultDurationMinutes Int?
  createdAt              DateTime           @default(now())
  updatedAt              DateTime           @updatedAt
  items                  TaskTemplateItem[]

  @@unique([organizationId, name])
}

model TaskTemplateItem {
  id          String       @id @default(auto()) @map("_id") @db.ObjectId
  templateId  String       @db.ObjectId
  template    TaskTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  title       String
  description String?
  type        String       @default("CHECKLIST")
  order       Int          @default(0)
  createdAt   DateTime     @default(now())

  @@index([templateId, order])
}

model EmailNotification {
  id             String        @id @default(auto()) @map("_id") @db.ObjectId
  organizationId String?       @db.ObjectId
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId         String?       @db.ObjectId
  user           User?         @relation(fields: [userId], references: [id], onDelete: SetNull)
  taskId         String?       @db.ObjectId
  task           Task?         @relation(fields: [taskId], references: [id], onDelete: SetNull)
  type           String
  subject        String
  recipient      String
  status         String        @default("PENDING")
  sentAt         DateTime?
  createdAt      DateTime      @default(now())

  @@index([status, createdAt])
}

model WebhookEvent {
  id             String        @id @default(auto()) @map("_id") @db.ObjectId
  organizationId String?       @db.ObjectId
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  eventType      String
  payload        String
  processed      Boolean       @default(false)
  createdAt      DateTime      @default(now())

  @@index([eventType, processed])
}

model AutomationTrigger {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  automationId String   @db.ObjectId
  eventType    String
  createdAt    DateTime @default(now())
}

model AutomationCondition {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  automationId String   @db.ObjectId
  field        String
  operator     String
  value        String
  createdAt    DateTime @default(now())
}

model AutomationAction {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  automationId String   @db.ObjectId
  type         String
  payload      String
  createdAt    DateTime @default(now())
}