generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

enum RoleName {
  SUPER_ADMIN
  OWNER
  ADMIN
  DEPARTMENT_HEAD
  MANAGER
  TEAM_LEADER
  EMPLOYEE
  GUEST
}

enum TaskStatus {
  DRAFT
  ASSIGNED
  SEEN
  ACCEPTED
  IN_PROGRESS
  WAITING
  BLOCKED
  REVIEW
  COMPLETED
  APPROVED
  REJECTED
  CANCELLED
  OVERDUE
  ON_HOLD
  NEEDS_CLARIFICATION
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum IntegrationStatus {
  PENDING
  ACTIVE
  FAILED
  RETRY_REQUIRED
}

model Organization {
  id             String              @id @default(cuid())
  name           String
  slug           String              @unique
  timezone       String              @default("UTC")
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
  users          User[]
  departments    Department[]
  teams          Team[]
  projects       Project[]
  tasks          Task[]
  goals          Goal[]
  notifications  Notification[]
  reminders      Reminder[]
  automations    Automation[]
}

model Permission {
  id        String   @id @default(cuid())
  name      String   @unique
  createdAt DateTime @default(now())
  roles     Role[]
}

model Role {
  id        String       @id @default(cuid())
  name      RoleName     @unique
  users     User[]
  permissions Permission[]
  createdAt DateTime     @default(now())
}

model User {
  id                   String              @id @default(cuid())
  name                 String
  email                String              @unique
  passwordHash         String?
  avatarUrl            String?
  timezone             String              @default("UTC")
  organizationId       String?
  organization         Organization?       @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  roleId               String?
  role                 Role?               @relation(fields: [roleId], references: [id], onDelete: SetNull)
  teamId               String?
  team                 Team?               @relation(fields: [teamId], references: [id], onDelete: SetNull)
  departmentId         String?
  department           Department?         @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt
  tasksCreated         Task[]              @relation("TaskCreator")
  taskAssignments      TaskAssignee[]
  comments             Comment[]
  notifications        Notification[]
  activityLogs         ActivityLog[]
  projectMembership    ProjectMember[]
  goals               Goal[]
  timeEntries          TimeEntry[]
  reminders           Reminder[]
  approvals           Approval[]
  calendarIntegrations CalendarIntegration[]

  @@index([organizationId])
  @@index([email])
}

model Department {
  id             String     @id @default(cuid())
  name           String
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  users          User[]
  teams          Team[]
  tasks          Task[]
  createdAt      DateTime   @default(now())

  @@index([organizationId])
}

model Team {
  id             String       @id @default(cuid())
  name           String
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  departmentId   String?
  department     Department?  @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  members        User[]
  tasks          Task[]
  createdAt      DateTime     @default(now())

  @@index([organizationId])
}

model Project {
  id             String          @id @default(cuid())
  name           String
  description    String?
  deadline       DateTime?
  organizationId String
  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  members        ProjectMember[]
  tasks          Task[]
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  @@index([organizationId])
}

model ProjectMember {
  id        String  @id @default(cuid())
  userId    String
  projectId String
  role      String  @default("member")
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([userId, projectId])
}

model Task {
  id                  String          @id @default(cuid())
  title               String
  description         String?
  status              TaskStatus      @default(DRAFT)
  priority            TaskPriority    @default(MEDIUM)
  organizationId      String
  organization        Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  projectId           String?
  project             Project?        @relation(fields: [projectId], references: [id], onDelete: SetNull)
  departmentId        String?
  department          Department?     @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  teamId              String?
  team                Team?           @relation(fields: [teamId], references: [id], onDelete: SetNull)
  creatorId           String?
  creator             User?           @relation("TaskCreator", fields: [creatorId], references: [id], onDelete: SetNull)
  assignees           TaskAssignee[]
  assigneeEmail       String?
  dueAt               DateTime?
  startAt             DateTime?
  estimatedMinutes    Int?
  actualMinutes       Int?
  recurrence          String?
  calendarSyncEnabled Boolean         @default(false)
  emailEnabled        Boolean         @default(true)
  completedAt         DateTime?
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt
  comments            Comment[]
  reminders           Reminder[]
  notifications       Notification[]
  approvals           Approval[]
  timeEntries         TimeEntry[]
  dependencies        TaskDependency[] @relation("TaskDependencySource")
  dependentTasks      TaskDependency[] @relation("TaskDependencyTarget")
  calendarEvent       CalendarEvent?
  activityLogs        ActivityLog[]

  @@index([organizationId, status])
  @@index([dueAt])
  @@index([projectId])
}

model TaskAssignee {
  id     String @id @default(cuid())
  taskId String
  userId String
  task   Task   @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([taskId, userId])
}

model TaskDependency {
  id          String @id @default(cuid())
  taskId      String
  dependsOnId String
  task        Task   @relation("TaskDependencySource", fields: [taskId], references: [id], onDelete: Cascade)
  dependsOn   Task   @relation("TaskDependencyTarget", fields: [dependsOnId], references: [id], onDelete: Cascade)

  @@unique([taskId, dependsOnId])
}

model Comment {
  id        String   @id @default(cuid())
  content   String
  taskId    String
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  authorId  String
  author    User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Notification {
  id             String       @id @default(cuid())
  type           String
  content        String
  read           Boolean      @default(false)
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  taskId         String?
  task           Task?        @relation(fields: [taskId], references: [id], onDelete: SetNull)
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdAt      DateTime     @default(now())

  @@index([userId, read])
}

model Reminder {
  id             String       @id @default(cuid())
  taskId         String
  task           Task         @relation(fields: [taskId], references: [id], onDelete: Cascade)
  userId         String?
  user           User?        @relation(fields: [userId], references: [id], onDelete: SetNull)
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  sendAt         DateTime
  type           String
  sent           Boolean      @default(false)
  createdAt      DateTime     @default(now())

  @@index([sendAt, sent])
}

model CalendarIntegration {
  id               String             @id @default(cuid())
  userId           String
  user             User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider         String             @default("google")
  googleCalendarId String?
  accessToken      String?
  refreshToken     String?
  expiresAt        DateTime?
  status           IntegrationStatus  @default(PENDING)
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  @@unique([userId, provider])
}

model CalendarEvent {
  id            String            @id @default(cuid())
  taskId        String            @unique
  task          Task              @relation(fields: [taskId], references: [id], onDelete: Cascade)
  googleEventId String?
  status        IntegrationStatus @default(PENDING)
  lastSyncedAt  DateTime?
  syncError     String?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
}

model Automation {
  id             String      @id @default(cuid())
  name           String
  whenTrigger    String
  condition      String
  action         String
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  enabled        Boolean     @default(true)
  createdAt      DateTime    @default(now())
}

model Goal {
  id             String      @id @default(cuid())
  title          String
  targetValue    Int
  currentValue   Int         @default(0)
  ownerId        String?
  owner          User?       @relation(fields: [ownerId], references: [id], onDelete: SetNull)
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdAt      DateTime    @default(now())
}

model Approval {
  id        String   @id @default(cuid())
  taskId    String
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  reviewerId String
  reviewer  User     @relation(fields: [reviewerId], references: [id], onDelete: Cascade)
  status    String   @default("PENDING")
  reason    String?
  createdAt DateTime @default(now())
}

model TimeEntry {
  id        String   @id @default(cuid())
  taskId    String
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  minutes   Int
  note      String?
  createdAt DateTime @default(now())
}

model ActivityLog {
  id        String    @id @default(cuid())
  taskId    String?
  task      Task?     @relation(fields: [taskId], references: [id], onDelete: SetNull)
  userId    String?
  user      User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
  action    String
  details   String?
  createdAt DateTime  @default(now())

  @@index([taskId, createdAt])
}

model UserPreference {
  id            String   @id @default(cuid())
  userId        String   @unique
  theme         String   @default("light")
  timezone      String   @default("UTC")
  notifications Boolean  @default(true)
  emailDigest   Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model AuditLog {
  id        String   @id @default(cuid())
  actorId   String?
  action    String
  target    String?
  details   String?
  createdAt DateTime @default(now())
}

model OauthAccount {
  id                String   @id @default(cuid())
  provider          String
  providerAccountId String
  userId            String
  accessToken       String?
  refreshToken      String?
  expiresAt         DateTime?
  createdAt         DateTime @default(now())

  @@unique([provider, providerAccountId])
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
}
